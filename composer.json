{
	"name": "flarum-lang/thai",
	"description": "Thai Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/thai",
	"license": "MIT",
	"support": {
		"issues": "https://github.com/flarum-lang/thai/issues",
		"forum": "https://discuss.flarum.org/d/28873",
		"source": "https://github.com/flarum-lang/thai"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "Thai",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundColor": "#00247d",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "th",
			"title": "ภาษาไทย"
		}
	}
}
